!
!#RUN ##########################################################################
!
!#DOAMR
!F			DoAmr
!
!#TIMEACCURATE
!T			IsTimeAccurate
!
!#PARTLOCALTIMESTEP
!1.1			rLocalTimeStep
!
!! Perturb with GL CME
!#USERSWITCH
!+perturb		StringSwitch
!
!#CME
!T			UseCme
!T			DoAddFluxRope
!-1.			tDecayCme
!80.0			LongitudeCme
!-10.0			LatitudeCme
!0.0			OrientationCme
!SPHEROMAK		TypeCme
!1.4			BStrength
!-1			iHelicity
!1.03			Radius
!0.7			Stretch
!1.13			ApexHeight
!600			uCme
!
!#STOP
100			MaxIteration
!5.0			tSimulationMax
!
!#RUN ##########################################################################
!
!! perturb with TD14 CME
!#USERSWITCH
!+perturb		StringSwitch
!
!#CME
!T			UseCme
!T			DoAddFluxRope
!-1.0			tDecayCme
!180.0			LongitudeCme
!15.0			LatitudeCme
!120.0			OrientationCme
!TD14			TypeCme
!+1			iHelicity
!1.005747126436782		RadiusMajor
!0.431034482758621		RadiusMinor
!0.1436781609195402		Depth
!cancelflux		TypeBStrap
!1.79519580205131		BcTubeDim
!5.9916085277386298E+02		bQStrapFraction ! Increased to notice effect
!0.4			qDistance
!10			UChargeX
!
!#STOP
100			MaxIteration
!10.0			tSimulationMax
!
!#RUN ##########################################################################
!
!#STOP
100			MaxIteration
!100.0			tSimulationMax
