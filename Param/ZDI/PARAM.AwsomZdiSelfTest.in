#DESCRIPTION
Param/ZDI/PARAM.AwsomZdiSelfTest.in		StringDescription
! Canonical AWSoM user-module ZDI startup self-test (pure ZDI target dumps).
! Purpose: validate BATSRUS ZDI evaluator against ZDIpy before PFSS/BC evolution.

#COMPONENT
SC			NameComp

#TIMEACCURATE
F			IsTimeAccurate

#STARTTIME
2011			iYear
2			iMonth
16			iDay
17			iHour
26			iMinute
0			iSecond

#SAVERESTART
T			DoSaveRestart
10000			DnSaveRestart
-1.0			DtSaveRestart

#COORDSYSTEM
HGR			TypeCoordSystem

#PLASMA
1.0			FluidMass [amu]
1.0			IonCharge [e]
1.0			ElectronTemperatureRatio

!#HARMONICSFILE
!Param/CORONA/CR2077_GNG.dat		NameHarmonicsFile
!
!HARMONICSGRID
!1.0			rMagnetogram
!25.0			rSourceSurface
!T			IsLogRadius
!180			MaxOrder
!100			nR
!180			nLon
!90			nLat
!
#POYNTINGFLUX
1e6			PoyntingFluxPerBSi

#CORONALHEATING
turbulentcascade		TypeCoronalHeating
1.5e5			LperpTimesSqrtBSi
0.0			rMinWaveReflection
F			UseReynoldsDecomposition

#HEATPARTITIONING
stochasticheating		TypeHeatPartitioning
0.21			StochasticExponent
0.18			StochasticAmplitude

#RADIATIVECOOLING
T			UseRadCooling

#USERSWITCH
+init +ic		StringSwitch

#COARSEAXIS
T			UseCoarseAxis
2			nCoarseLayer

#USERINPUTBEGIN -----------------------------------

#CHROMOBC
2e17			NchromoSi
5e4			TchromoSi

#ZDIMAGNETOGRAM
T			UseZdiMagnetogram
Param/ZDI/coeff-Mel25-5.dat	NameZdiCoeffFile
0.1			ZdiFieldScaleIo
0.0			ZdiLonShiftDeg

#ZDIBOUNDARY
F			UseZdiBoundary
F			UseZdiBoundaryRadial
off			TypeZdiBoundary
none			TypeZdiRamp
1.0			ZdiBcStrength
1.0			ZdiBcScale
1			ZdiRampIterStart
30			ZdiRampIterStop
-1.0			ZdiRampStart
-1.0			ZdiRampStop

#ZDISELFTEST
T			UseZdiSelfTest
Param/ZDI/ZDI.selftest.points.dat			NameZdiSelfTestPointFile
zdi_selftest_points.out			NameZdiSelfTestDumpFile
zdi_selftest_field_2d.out			NameZdiSelfTestImageFile
T			DoZdiSelfTestSingleCoeff
zdi_selftest_singlecoeff_points.out			NameZdiSelfTestCoeffDumpFile
zdi_selftest_singlecoeff			NameZdiSelfTestCoeffImagePrefix
2			ZdiSelfTestCoeffLmax
0.0			ZdiSelfTestLonMinDeg
360.0			ZdiSelfTestLonMaxDeg
30.0			ZdiSelfTestDLonDeg
-90.0			ZdiSelfTestLatMinDeg
90.0			ZdiSelfTestLatMaxDeg
15.0			ZdiSelfTestDLatDeg

#USERINPUTEND -------------------------------------

#TRANSITIONREGION
T			DoExtendTransitionRegion
2.2e5			TeTransitionRegionSi
1.0e1			DeltaTeModSi

#GRIDGEOMETRY
spherical_genr		TypeGeometry
Param/CORONA/grid_awsom.dat		NameGridFile

! Use a true sphere, so box is made much larger
#GRID
1			nRootBlock1
2			nRootBlock2
1			nRootBlock3
-100.0			xMin
 100.0			xMax
-100.0			yMin
 100.0			yMax
-100.0			zMin
 100.0			zMax

#GRIDBLOCKALL
4000			MaxBlock

#LIMITRADIUS
1.0			rMin
24.0			rMax

#AMRREGION
InnerShell		NameRegion
shell0			StringShape
1.0			RadiusInner
1.7			Radius

#AMRCRITERIARESOLUTION
3			nRefineCrit
dphi			StringRefine
12.0			RefineTo
6.0			CoarsenFrom
dphi Innershell		StringRefine
1.5  			RefineTo
0.75			CoarsenFrom
currentsheet		StringRefine
0.5			CoarsenLimit
0.5			RefineLimit
1.5			MaxResolution

#GRIDRESOLUTION
12.0			Resolution
initial			StringShape

#LOOKUPTABLE
radcool			NameTable
load			NameCommand
Param/CORONA/RadCoolCorona.dat		NameFile
ascii			TypeFile

#DOAMR
T			DoAmr
40			DnAmr
-1			DtAmr
T			IsStrictAmr

#TIMESTEPPING
2			nStage
0.8			CflExpl

#SCHEME
2			nOrder (1 or 2)
Linde			TypeFlux
mc3			TypeLimiter
1.2			LimiterBeta

#LIMITER
T			UseLogRhoLimiter
T			UseLogPLimiter
F			UseRhoRatioLimiter

#MINIMUMTEMPERATURE
5.0e4			TminDim
5.0e4			TeMinDim

#MINIMUMPRESSURE
1.0E-9			pMinDim
1.0e-9			PeMinDim

#MINIMUMRADIALSPEED
T			UseSpeedMin
10			rSpeedMin
500			SpeedMinDim  ! 250km/s has no effect in this test
10 h			TauSpeedMinDim

#NONCONSERVATIVE
T			UseNonConservative

#RESCHANGE
T			UseAccurateReschange

#SAVELOGFILE
T			DoSaveLogfile
RAW			StringLog
1			DnSaveLogfile
-1.			DtSaveLogfile

#OUTERBOUNDARY
user			TypeBc1
float			TypeBc2
periodic		TypeBc3
periodic		TypeBc4
periodic		TypeBc5
periodic		TypeBc6

#TRACEACCURACY
5.0			AccuracyFactor

#SQUASHFACTOR
720			nLonSquash
360			nLatSquash
20.0			AccuracyFactorSquash

#SAVEPLOT
1			nPlotFile
shl VAR idl_ascii		StringPlot
10000			DnSavePlot
-1.0			DtSavePlot
HGR			TypeCoord
1.0			rMin
1.0			rMax
0.0			LonMin
360.0			LonMax
10.0			dLon
-90.0			LatMin
90.0			LatMax
10.0			dLat
br bphi btheta zdibr zdibphi zdibtheta		NameVars
{default}		NamePars

#SAVEINITIAL
T			DoSaveInitial

#DOAMR
F			DoAmr

#STOP
1			MaxIteration
-1.0			tSimulationMax
